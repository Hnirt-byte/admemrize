# --- Postgres ---
POSTGRES_PASSWORD=change-me
# En dev local (API lancée sur l'hôte, Postgres exposé via docker-compose.override.yml) : localhost
# Sur le VPS (API dans son conteneur, réseau "internal") : remplacer "localhost" par "postgres"
DATABASE_URL=postgres://admemrize:change-me@localhost:5432/admemrize

# --- JWT (organisateur) ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# --- JWT (invité) — secret distinct, jamais partagé avec l'organisateur ---
JWT_GUEST_SECRET=change-me-guest

# --- Stockage objet S3-compatible (Scaleway Object Storage) ---
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=admemrize-events
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Durée de vie de l'URL signée d'upload, en secondes.
UPLOAD_URL_TTL_SECONDS=300
# Durée de vie des URL signées de lecture émises après la révélation (Phase 5).
DOWNLOAD_URL_TTL_SECONDS=900
# Quotas anti-abus (section 12 du master prompt), configurables sans déploiement de code.
SESSION_PHOTO_QUOTA=500
EVENT_PHOTO_QUOTA=10000

# --- App ---
APP_NAME=ADMEMRIZE
# Domaine public réel, utilisé UNIQUEMENT par les labels Traefik en prod (docker-compose.yml).
# Sans effet en dev local. À remplacer avant le déploiement VPS.
ADMEMRIZE_DOMAIN=admemrize.ton-domaine.fr
# Origine autorisée en CORS côté API — laisse localhost:5173 en dev, mets l'URL https en prod.
APP_DOMAIN=http://localhost:5173
SUPPORT_EMAIL=support@example.com
API_PORT=3000

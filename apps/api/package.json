    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.2.1",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^5.10.0",
    "postgres": "^3.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.0.0",
